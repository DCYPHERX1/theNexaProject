# Auto-detect text files, then pin common project formats.
* text=auto

*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf
*.example text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitkeep text eol=lf

*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
