PORT=4000
NODE_ENV=development

# Comma-separated frontend origins. Keep this specific in production.
FRONTEND_ORIGINS=http://localhost:5177,http://127.0.0.1:5177,http://localhost:4173,http://127.0.0.1:4173

# Supabase project connection.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWTs are still issued by Supabase Auth. Only set this if you later add local signed tokens.
JWT_SECRET=replace-with-long-random-secret

# Root-only Super Admin login. Never expose these values to the browser.
ROOT_SUPER_ADMIN_EMAIL=your-real-admin-email
ROOT_SUPER_ADMIN_PASSWORD=replace-with-private-root-password
ROOT_SUPER_ADMIN_SECRET_PHRASE=your-new-long-random-secret
ROOT_SUPER_ADMIN_SESSION_PASSWORD=replace-with-private-generated-session-password

# Staff signup phrase used only during staff verification.
STAFF_VERIFICATION_PHRASE=replace-with-private-staff-phrase

# Optional alert delivery for Phase 4.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail SMTP delivery. Use a Gmail App Password, not your normal Gmail password.
GMAIL_USER=admin.nexaa@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_FROM=admin.nexaa@gmail.com
GMAIL_FROM_NAME=Nexaa Archive
SUPPORT_ADMIN_EMAIL=admin.nexaa@gmail.com

# Optional Google reCAPTCHA. When both are set, signup OTP requests require a valid token.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
